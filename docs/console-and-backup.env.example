# Copy relevant lines into your project .env (or merge with .env.example).
# Master enable stays env-only. Other console knobs live in Settings → Console
# (and Security for 2FA / grant). Uncomment a line to lock that knob; env wins
# when set and non-empty. Bundled compose does not inject these defaults.

# --- Web SSH console ---
# Master enable (default off). Popup + multi-host /console when on.
PIHERDER_SSH_CONSOLE=false
# Optional locks (leave unset to use Settings):
# PIHERDER_SSH_CONSOLE_REQUIRE_2FA_EVERY_SHELL=false
# PIHERDER_SSH_CONSOLE_ALLOW_BACKUP_CODES=false
# PIHERDER_SSH_CONSOLE_PREFER_PASSKEY=true
# PIHERDER_SSH_CONSOLE_REQUIRE_PASSKEY=false
# PIHERDER_SSH_CONSOLE_BIND_IP=true
# PIHERDER_SSH_CONSOLE_BIND_DEVICE=true
# PIHERDER_SSH_CONSOLE_REVALIDATE_SEC=10
# PIHERDER_SSH_CONSOLE_TICKET_SEC=60
# PIHERDER_SSH_CONSOLE_IDLE_SEC=900
# PIHERDER_SSH_CONSOLE_MAX_SEC=3600
# PIHERDER_SSH_CONSOLE_MAX_PER_USER=4
# PIHERDER_SSH_CONSOLE_MAX_GLOBAL=20
# PIHERDER_SSH_CONSOLE_SCROLLBACK=2000
# PIHERDER_SSH_CONSOLE_HOLD_SEC=0
# PIHERDER_SSH_CONSOLE_GRANT_MIN=10
# PIHERDER_SSH_CONSOLE_PRIVILEGED_ROLE=admin
# PIHERDER_SSH_CONSOLE_AUDIT_MODE=off
# PIHERDER_SSH_CONSOLE_AUDIT_REQUIRED=false
# PIHERDER_SSH_CONSOLE_AUDIT_RETENTION_DAYS=14

# --- Host Files (v1.3) ---
# Master enable (default off). Dest-card + /servers/{id}/files when on.
PIHERDER_HOST_FILES=false
# Optional upload cap (bytes). Uncomment to lock; code default is 512 MiB, ceiling 2 GiB.
# PIHERDER_HOST_FILES_MAX_BYTES=536870912

# --- CSP (v1.2) ---
PIHERDER_CSP=true
PIHERDER_CSP_REPORT_ONLY=false

# --- B-retry vanished rsync (v1.2 Stream B) ---
PIHERDER_BACKUP_VANISHED_RETRIES=1
PIHERDER_BACKUP_VANISHED_RETRY_DELAY_SEC=5
PIHERDER_BACKUP_VANISHED_SOFT_OK=true
