# Copy to .env.authentik and fill in before:
#   docker compose -f docker-compose.authentik.yml --env-file .env.authentik up -d

# Required — long random string (e.g. openssl rand -base64 36)
AUTHENTIK_SECRET_KEY=

# First admin (created on empty DB)
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@localhost.local
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin-change-me

# Postgres for Authentik only (not PiHerder's DB)
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_PASS=changeme-ak-pg
AUTHENTIK_PG_DB=authentik

# Host ports
AUTHENTIK_PORT_HTTP=9000
AUTHENTIK_PORT_HTTPS=9443

# Optional pin (default in compose)
# AUTHENTIK_IMAGE=ghcr.io/goauthentik/server:2025.2.1
