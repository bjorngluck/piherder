# PiHerder Caddyfile — production-oriented
# Host ports (compose): 8888→80 (HTTP), 8443→443 (HTTPS)
# Trusted TLS: place fullchain.pem + privkey.pem in ./certs (mounted at /certs)
# Hostname: set PIHERDER_HOSTNAME in .env (e.g. piherder.example.com)
#
# Host header: only PIHERDER_HOSTNAME is served. Other Host / bare-IP requests
# get 421 so opening origin to Cloudflare (or anyone) does not expose the app
# under an alternate name.
#
# Client IP: the default path does not trust headers the client sent.
# X-Real-IP and X-Forwarded-For are the TCP peer Caddy accepted.
# CF-Connecting-IP and True-Client-IP are removed before the proxy.
# A CF-Connecting-IP header is not proof that Cloudflare sent the request.
#
# Cloudflare opt-in is off. Uncomment the servers block in the global options
# and paste the current ranges from https://www.cloudflare.com/ips/
# The list has to be kept current. Then forward {client_ip} instead of {remote_host}.
#
# Local dev without certs: use Caddyfile.dev (see docs/ADMIN.md)

{
	# Admin on all interfaces inside the compose network only (port NOT published to host).
	# web uses this to reload TLS after "Apply to this PiHerder" without docker.sock.
	admin 0.0.0.0:2019
	# Non-standard host ports; do not auto-redirect HTTP→HTTPS on 443
	auto_https off

	# Cloudflare opt-in (off). Uncomment, paste the current ranges from
	# https://www.cloudflare.com/ips/ and keep that list current. Then, in the
	# reverse_proxy below, forward {client_ip} instead of {remote_host}.
	# servers {
	#	trusted_proxies static <Cloudflare ranges>
	#	client_ip_headers CF-Connecting-IP
	# }
}

# HTTP — host :8888 (or :80 on demo)
# Only the configured public hostname is accepted (redirect to HTTPS public URL).
# Everything else (IP, wrong Host, empty Host) → 421.
:80 {
	@allowed host {$PIHERDER_HOSTNAME}
	handle @allowed {
		redir {$PIHERDER_PUBLIC_URL}{uri} 308
	}
	handle {
		respond "Misdirected Request" 421
	}
}

# HTTPS — only this hostname (Host + site address). Cert SANs must include it.
{$PIHERDER_HOSTNAME}:443 {
	tls /certs/fullchain.pem /certs/privkey.pem

	# Belt-and-suspenders: refuse if Host is not exactly the site name
	# (site address already scopes this block; explicit matcher documents intent)
	@wrong_host not host {$PIHERDER_HOSTNAME}
	abort @wrong_host

	handle {
		reverse_proxy web:8000 {
			flush_interval -1
			header_up -CF-Connecting-IP
			header_up -True-Client-IP
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {http.request.host}
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "no-referrer-when-downgrade"
	}
	# Do not gzip file downloads — buffering stalls SFTP streams around ~12 MiB.
	encode gzip {
		match {
			header Content-Type text*
			header Content-Type application/javascript*
			header Content-Type application/json*
			header Content-Type application/xml*
			header Content-Type application/xhtml+xml*
			header Content-Type image/svg+xml*
		}
	}
}

# Catch-all HTTPS: wrong Host / bare IP / unknown SNI → do not proxy to the app.
# More specific {$PIHERDER_HOSTNAME}:443 wins when Host matches.
:443 {
	respond "Misdirected Request" 421
}
