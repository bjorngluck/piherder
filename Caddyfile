# PiHerder Caddyfile — production-oriented
# Host ports (compose): 8888→80 (HTTP), 8443→443 (HTTPS)
# Trusted TLS: place fullchain.pem + privkey.pem in ./certs (mounted at /certs)
# Hostname: set PIHERDER_HOSTNAME in .env (e.g. piherder.example.com)
#
# Client IP: when Cloudflare proxies (orange cloud), the TCP peer is a CF edge
# address. Use CF-Connecting-IP as X-Real-IP / X-Forwarded-For so the app and
# Turnstile siteverify see the real visitor. Direct (non-CF) traffic uses remote_host.
#
# Local dev without certs: use Caddyfile.dev (see docs/ADMIN.md)

{
	# Admin on all interfaces inside the compose network only (port NOT published to host).
	# web uses this to reload TLS after "Apply to this PiHerder" without docker.sock.
	admin 0.0.0.0:2019
	# Non-standard host ports; do not auto-redirect HTTP→HTTPS on 443
	auto_https off
}

# Shared reverse_proxy snippet behaviour is duplicated for HTTP/HTTPS + CF vs direct.

# HTTP — host :8888 (or :80 on demo)
# Redirect target: PIHERDER_PUBLIC_URL when set (demo https://host, prod may include :8443).
# Do NOT hardcode :8443 — demo publishes 443 and Cloudflare terminates on 443.
:80 {
	@public host {$PIHERDER_HOSTNAME}
	redir @public {$PIHERDER_PUBLIC_URL}{uri} 308

	# Cloudflare orange-cloud: visitor IP in CF-Connecting-IP
	@from_cf header CF-Connecting-IP *
	handle @from_cf {
		reverse_proxy web:8000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	# Direct to origin (no CF header)
	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
		}
	}
	encode gzip
}

# HTTPS — host :8443 (or :443 when published as such)
{$PIHERDER_HOSTNAME}:443 {
	tls /certs/fullchain.pem /certs/privkey.pem

	@from_cf header CF-Connecting-IP *
	handle @from_cf {
		reverse_proxy web:8000 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
			header_up CF-Connecting-IP {http.request.header.CF-Connecting-IP}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		reverse_proxy web:8000 {
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Host {host}
		}
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer-when-downgrade"
	}
	encode gzip
}
